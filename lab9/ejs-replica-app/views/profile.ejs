<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user.name %> | LinkedIn Replica</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/"><strong>In</strong> Replica</a>
            <div class="d-flex align-items-center">
                <a href="/" class="btn btn-light btn-sm text-primary fw-semibold rounded-pill px-3">Home</a>
            </div>
        </div>
    </nav>

    <div class="container pb-5 mt-4">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">
                
                <!-- Header Section -->
                <div class="card mb-4 border-0 overflow-hidden">
                    <img src="<%= user.coverImage %>" class="cover-image w-100" alt="Cover Image">
                    <div class="card-body position-relative pb-4 px-4">
                        <div class="profile-picture-container">
                            <img src="<%= user.profileImage %>" alt="<%= user.name %>" class="profile-picture">
                            <% if (user.openToWork) { %>
                                <div class="open-to-work-badge">#OPEN TO WORK</div>
                            <% } %>
                        </div>
                        
                        <div class="mt-5 pt-3">
                            <div class="d-flex justify-content-between align-items-start flex-wrap">
                                <div class="mb-2">
                                    <h1 class="h3 mb-1 fw-bold"><%= user.name %></h1>
                                    <p class="fs-5 mb-1"><%= user.headline %></p>
                                    <p class="text-muted mb-2 small">
                                        <%= user.location %> &bull; 
                                        <a href="#" class="text-primary text-decoration-none fw-semibold hover-underline"><%= user.followers %> followers</a> &bull; 
                                        <a href="#" class="text-primary text-decoration-none fw-semibold hover-underline"><%= user.connections %> connections</a>
                                    </p>
                                </div>
                                <div class="mt-2 mt-md-0">
                                    <span class="badge bg-secondary">Replica Profile</span>
                                </div>
                            </div>
                            
                            <div class="mt-2 d-flex flex-wrap gap-2">
                                <button class="btn btn-primary rounded-pill px-4">Connect</button>
                                <button class="btn btn-outline-primary rounded-pill px-4">Message</button>
                                <button class="btn btn-outline-secondary rounded-pill px-4">More</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- About Section -->
                <% if (user.about) { %>
                <div class="card mb-4 border-0">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-3 fs-5">About</h4>
                        <p class="card-text"><%= user.about %></p>
                    </div>
                </div>
                <% } %>

                <!-- Experience Section -->
                <% if (user.experience && user.experience.length > 0) { %>
                <div class="card mb-4 border-0">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-4 fs-5">Experience</h4>
                        <% user.experience.forEach((exp, index) => { %>
                            <div class="d-flex mb-3">
                                <div class="me-3 mt-1">
                                    <div class="experience-icon">
                                        <%= exp.company.charAt(0) %>
                                    </div>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-1 fs-6"><%= exp.role %></h5>
                                    <p class="mb-1"><%= exp.company %></p>
                                    <p class="text-muted small mb-2"><%= exp.duration %></p>
                                    <p class="mb-0"><%= exp.description %></p>
                                </div>
                            </div>
                            <% if (index < user.experience.length - 1) { %>
                                <hr class="text-muted opacity-25 my-4">
                            <% } %>
                        <% }); %>
                    </div>
                </div>
                <% } %>

                <!-- Education Section -->
                <% if (user.education && user.education.length > 0) { %>
                <div class="card mb-4 border-0">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-4 fs-5">Education</h4>
                        <% user.education.forEach((edu, index) => { %>
                            <div class="d-flex mb-3">
                                <div class="me-3 mt-1">
                                    <div class="experience-icon">
                                        <%= edu.college.charAt(0) %>
                                    </div>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-1 fs-6"><%= edu.college %></h5>
                                    <p class="mb-1"><%= edu.degree %></p>
                                    <p class="text-muted small mb-0"><%= edu.year %></p>
                                </div>
                            </div>
                            <% if (index < user.education.length - 1) { %>
                                <hr class="text-muted opacity-25 my-3">
                            <% } %>
                        <% }); %>
                    </div>
                </div>
                <% } %>

                <!-- Skills Section -->
                <% if (user.skills && user.skills.length > 0) { %>
                <div class="card mb-4 border-0">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-4 fs-5">Skills</h4>
                        <div class="d-flex flex-wrap gap-2">
                            <% user.skills.forEach(skill => { %>
                                <span class="badge skill-badge px-3 py-2 rounded-pill fs-6"><%= skill %></span>
                            <% }); %>
                        </div>
                    </div>
                </div>
                <% } %>
                
                <!-- Contact Section -->
                <% if (user.contact) { %>
                <div class="card mb-4 border-0">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-4 fs-5">Contact Information</h4>
                        <ul class="list-unstyled mb-0">
                            <% if (user.contact.email) { %>
                            <li class="mb-3 d-flex align-items-center">
                                <span class="text-muted me-3 fs-5" style="width: 24px;">✉️</span>
                                <a href="mailto:<%= user.contact.email %>" class="text-primary text-decoration-none fw-semibold"><%= user.contact.email %></a>
                            </li>
                            <% } %>
                            
                            <% if (user.contact.phone) { %>
                            <li class="mb-3 d-flex align-items-center">
                                <span class="text-muted me-3 fs-5" style="width: 24px;">📱</span>
                                <span class="fw-semibold"><%= user.contact.phone %></span>
                            </li>
                            <% } %>
                            
                            <% if (user.contact.linkedin) { %>
                            <li class="d-flex align-items-center">
                                <span class="text-muted me-3 fs-5" style="width: 24px;">🔗</span>
                                <a href="<%= user.contact.linkedin %>" target="_blank" class="text-primary text-decoration-none fw-semibold"><%= user.contact.linkedin %></a>
                            </li>
                            <% } %>
                        </ul>
                    </div>
                </div>
                <% } %>

            </div>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
