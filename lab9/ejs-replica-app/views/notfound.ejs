<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Not Found | LinkedIn Replica</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex flex-column min-vh-100">

    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-5">
        <div class="container">
            <a class="navbar-brand" href="/"><strong>In</strong> Replica</a>
        </div>
    </nav>

    <div class="container flex-grow-1 d-flex justify-content-center align-items-center">
        <div class="text-center p-5 bg-white rounded-4 shadow-sm border" style="max-width: 500px;">
            <div class="mb-4">
                <span style="font-size: 64px;">🔍</span>
            </div>
            <h2 class="fw-bold mb-3">Profile Not Found</h2>
            <p class="text-muted mb-4">
                We couldn't find a profile for <strong>"<%= username %>"</strong>. The user might have changed their username or the profile does not exist.
            </p>
            <a href="/" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">Return Home</a>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
