<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f7f8f5">
  <title><%= title %> · Campus Found</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="topbar">
    <div class="topbar-inner shell">
      <a class="brand" href="/" aria-label="Campus Found home">
        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><path d="M16 3.5 27 9.8v12.4L16 28.5 5 22.2V9.8L16 3.5Z" stroke="currentColor" stroke-width="1.8"/><path d="M11 16.1 14.4 19.5 21.7 12.2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <span class="brand-name">campus<span>found</span></span>
      </a>
      <nav class="main-nav" aria-label="Main navigation">
        <a class="nav-link <%= path.startsWith('/lost-items') ? 'is-active' : '' %>" href="/lost-items">Lost items</a>
        <a class="nav-link <%= path.startsWith('/found-items') ? 'is-active' : '' %>" href="/found-items">Found items</a>
        <a class="nav-link <%= path === '/report' ? 'is-active' : '' %>" href="/report">Report an item</a>
      </nav>
      <div class="account-area">
        <% if (activeStudent) { %>
          <a class="avatar-link" href="/students/<%= activeStudent._id %>" aria-label="View <%= activeStudent.fullName %>'s profile"><span class="avatar"><%= activeStudent.fullName.split(' ').map(word => word[0]).slice(0,2).join('').toUpperCase() %></span><span class="account-name"><%= activeStudent.fullName.split(' ')[0] %></span></a>
          <form action="/session/logout" method="post"><button class="text-button" type="submit">Sign out</button></form>
        <% } else { %>
          <a class="nav-link" href="/students/new#login">Sign in</a><a class="button button-small button-quiet" href="/students/new">Create profile</a>
        <% } %>
      </div>
    </div>
    <nav class="mobile-nav shell" aria-label="Mobile navigation"><a href="/lost-items">Lost</a><a href="/found-items">Found</a><a href="/report">Report</a></nav>
  </header>
  <% if (flash) { %><div class="flash-wrap shell"><div class="flash flash-<%= flash.type %>" role="status"><span class="flash-dot" aria-hidden="true"></span><%= flash.message %></div></div><% } %>
  <main id="main">
