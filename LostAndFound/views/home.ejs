<%- include('partials/header', { title }) %>
<section class="hero shell">
  <div class="hero-copy">
    <div class="eyebrow"><span class="eyebrow-mark"></span> A kinder campus starts here</div>
    <h1>Lost something?<br><em>It might be found.</em></h1>
    <p class="hero-lede">A shared place for our campus community to reunite people with the things they thought were gone.</p>
    <div class="hero-actions"><a class="button button-primary" href="/lost-items/new">Report something lost <span aria-hidden="true">↗</span></a><a class="button button-outline" href="/found-items">Browse found items</a></div>
    <div class="community-note"><span class="mini-avatars"><i>A</i><i>M</i><i>R</i></span><span>Good things make their way back.</span></div>
  </div>
  <div class="hero-art" aria-label="Illustration of a found notebook, key and leaf" role="img">
    <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
    <div class="art-sun"></div><div class="art-leaf leaf-one"></div><div class="art-leaf leaf-two"></div>
    <div class="art-note"><span class="note-clip"></span><span class="note-lines"></span><span class="note-lines short"></span><span class="note-lines"></span><span class="note-lines shorter"></span><span class="note-stamp">FOUND<br>ON CAMPUS</span></div>
    <div class="art-key"><span></span><i></i><b></b></div><div class="art-caption"><span class="caption-dot"></span> Little things, big relief</div>
  </div>
</section>
<section class="stats-band"><div class="shell stats-grid">
  <div class="stat-intro"><span class="eyebrow eyebrow-light">The campus board</span><h2>Every report<br>brings us closer.</h2></div>
  <div class="stat-cell"><span class="stat-number"><%= stats.lostCount %></span><span class="stat-label">still looking</span><span class="stat-icon stat-icon-rose">↗</span></div>
  <div class="stat-cell"><span class="stat-number"><%= stats.foundCount %></span><span class="stat-label">waiting for an owner</span><span class="stat-icon stat-icon-mint">✳</span></div>
  <div class="stat-cell"><span class="stat-number"><%= stats.returnedCount %></span><span class="stat-label">made it home</span><span class="stat-icon stat-icon-gold">✓</span></div>
</div></section>
<section class="section shell">
  <div class="section-heading"><div><span class="eyebrow">From around campus</span><h2>Recently found</h2><p>Take a look. Your next visit might bring something back.</p></div><a class="button button-quiet" href="/found-items">See all found items <span aria-hidden="true">→</span></a></div>
  <% if (recentFound.length) { %><div class="item-grid item-grid-three"><% recentFound.forEach((item, index) => { %>
    <article class="item-card"><a class="item-card-link" href="/found-items/<%= item._id %>"><div class="item-art item-art-<%= index %>"><span class="category-pill"><%= item.category %></span><span class="item-initial"><%= item.itemName.slice(0,1).toUpperCase() %></span><span class="card-arrow" aria-hidden="true">↗</span></div><div class="item-card-body"><div class="card-meta"><span><%= item.foundLocation %></span><span><%= new Date(item.dateFound).toLocaleDateString('en', { month: 'short', day: 'numeric' }) %></span></div><h3><%= item.itemName %></h3><p>Reported by <%= item.reportedBy ? item.reportedBy.fullName : 'a campus neighbor' %></p></div></a></article>
  <% }) %></div><% } else { %><div class="empty-state"><span class="empty-icon">✳</span><h3>It’s quiet on the found board.</h3><p>Be the first to help a lost item find its way home.</p><a class="button button-primary" href="/found-items/new">Report a found item</a></div><% } %>
</section>
<section class="callout shell"><div class="callout-leaf" aria-hidden="true">✳</div><div><span class="eyebrow eyebrow-light">You found it. Someone needs it.</span><h2>Be someone’s good news today.</h2><p>It only takes a minute to help a classmate get something important back.</p></div><a class="button button-light" href="/found-items/new">Report a found item <span aria-hidden="true">↗</span></a></section>
<%- include('partials/footer') %>
