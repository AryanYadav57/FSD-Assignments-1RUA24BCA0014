<%- include('partials/header', { title }) %>
<section class="page-hero shell"><div><span class="eyebrow"><%= type === 'lost' ? 'Still out there' : 'In caring hands' %></span><h1><%= type === 'lost' ? 'Lost items' : 'Found items' %></h1><p><%= type === 'lost' ? 'Search the board and help a campus neighbor find what they’re missing.' : 'A little detective work can make someone’s day.' %></p></div><a class="button button-primary" href="/<%= type %>-items/new">+ Report a <%= type %> item</a></section>
<section class="shell list-section">
  <form class="filter-bar" action="/<%= type %>-items" method="get"><div class="search-field"><label class="sr-only" for="itemSearch">Search items by name or location</label><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4 4"/></svg><input id="itemSearch" type="search" name="q" value="<%= filters.q %>" placeholder="Search item or campus location"><button class="search-submit" type="submit">Search</button></div><label class="filter-select"><span class="sr-only">Filter by category</span><select name="category" onchange="this.form.requestSubmit()"><option value="">All categories</option><% categories.forEach(category => { %><option value="<%= category %>" <%= filters.category === category ? 'selected' : '' %>><%= category %></option><% }) %></select></label><% if (type === 'found') { %><label class="filter-select"><span class="sr-only">Filter by status</span><select name="status" onchange="this.form.requestSubmit()"><option value="">All statuses</option><option value="Available" <%= filters.status === 'Available' ? 'selected' : '' %>>Waiting for owner</option><option value="Returned" <%= filters.status === 'Returned' ? 'selected' : '' %>>Returned</option></select></label><% } %></form>
  <% if (items.length) { %><div class="item-grid"><% items.forEach((item, index) => { const location = type === 'lost' ? item.lastSeenLocation : item.foundLocation; const date = type === 'lost' ? item.dateLost : item.dateFound; %><article class="item-card"><a class="item-card-link" href="/<%= type %>-items/<%= item._id %>"><div class="item-art item-art-<%= index % 3 %>"><span class="category-pill"><%= item.category %></span><span class="item-initial"><%= item.itemName.slice(0,1).toUpperCase() %></span><span class="card-arrow" aria-hidden="true">↗</span></div><div class="item-card-body"><div class="card-meta"><span><%= location %></span><span><%= new Date(date).toLocaleDateString('en', { month: 'short', day: 'numeric' }) %></span></div><h3><%= item.itemName %></h3><p><%= type === 'lost' ? 'Reported by ' : item.status === 'Returned' ? 'Returned · Reported by ' : 'Found by ' %><%= item.reportedBy ? item.reportedBy.fullName : 'a campus neighbor' %></p><% if (type === 'found') { %><span class="status status-<%= item.status.toLowerCase() %>"><span></span><%= item.status === 'Available' ? 'Waiting for owner' : 'Returned' %></span><% } %></div></a></article><% }) %></div><% } else { %><div class="empty-state empty-list"><span class="empty-icon"><%= type === 'lost' ? '⌕' : '✳' %></span><h3><%= filters.q || filters.category ? 'No items match those filters.' : `No ${type} items have been reported yet.` %></h3><p><%= filters.q || filters.category ? 'Try another search or clear the filters to see the full board.' : 'A report takes just a minute and could make a real difference.' %></p><% if (filters.q || filters.category || filters.status) { %><a class="button button-outline" href="/<%= type %>-items">Clear filters</a><% } else { %><a class="button button-primary" href="/<%= type %>-items/new">Report a <%= type %> item</a><% } %></div><% } %>
</section>
<%- include('partials/footer') %>
