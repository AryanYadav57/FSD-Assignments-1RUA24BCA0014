<%- include('partials/header', { title }) %>
<section class="form-page shell"><a class="back-link" href="/">← Back home</a><div class="form-layout"><div class="form-intro"><span class="eyebrow">Join the campus board</span><h1>Your people can help.</h1><p>Create a student account to post reports, make a claim, and help belongings find their way home.</p><div class="form-tip"><span>i</span><p>Your account keeps your reports together and helps us make sure only the finder can resolve a claim.</p></div></div><div class="profile-form-column"><form class="surface-form" action="/students" method="post"><div class="form-card-heading"><span class="eyebrow">New here?</span><h2>Create a profile</h2></div><% if (errors.length) { %><div class="form-errors" role="alert"><strong>A quick fix before you continue</strong><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %><div class="field"><label for="fullName">Full name</label><input id="fullName" name="fullName" required maxlength="100" autocomplete="name" value="<%= form.fullName || '' %>" placeholder="e.g. Maya Rao"></div><div class="field"><label for="email">College email</label><input id="email" name="email" type="email" required autocomplete="email" value="<%= form.email || '' %>" placeholder="you@college.edu"></div><div class="field"><label for="department">Department</label><input id="department" name="department" required maxlength="100" value="<%= form.department || '' %>" placeholder="e.g. Computer Applications"></div><div class="field"><label for="contactNumber">Contact number</label><input id="contactNumber" name="contactNumber" type="tel" required autocomplete="tel" value="<%= form.contactNumber || '' %>" placeholder="+91 98765 43210"></div><div class="field"><label for="password">Password</label><input id="password" name="password" type="password" required minlength="8" maxlength="72" autocomplete="new-password" placeholder="At least 8 characters"></div><button class="button button-primary button-full" type="submit">Create my profile <span aria-hidden="true">↗</span></button></form><form class="surface-form login-form" id="login" action="/session/login" method="post"><div class="form-card-heading"><span class="eyebrow">Already a member?</span><h2>Welcome back</h2></div><% if (loginError) { %><div class="form-errors" role="alert"><%= loginError %></div><% } %><div class="field"><label for="loginEmail">College email</label><input id="loginEmail" name="email" type="email" required autocomplete="username" placeholder="you@college.edu"></div><div class="field"><label for="loginPassword">Password</label><input id="loginPassword" name="password" type="password" required autocomplete="current-password" placeholder="Your password"></div><button class="button button-outline button-full" type="submit">Sign in</button></form></div></div></section>
<%- include('partials/footer') %>
