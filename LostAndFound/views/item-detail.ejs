<%- include('partials/header', { title }) %>
<section class="shell detail-page"><a class="back-link" href="/<%= type %>-items">← All <%= type %> items</a><div class="detail-layout"><div><div class="detail-art item-art item-art-<%= item.itemName.length % 3 %>"><span class="category-pill"><%= item.category %></span><span class="detail-initial"><%= item.itemName.slice(0,1).toUpperCase() %></span><span class="art-note-small">CAMPUS<br>FOUND</span></div><div class="detail-owner"><span class="avatar"><%= item.reportedBy ? item.reportedBy.fullName.split(' ').map(word => word[0]).slice(0,2).join('').toUpperCase() : 'CF' %></span><div><strong><%= type === 'lost' ? 'Reported by' : 'Found by' %> <%= item.reportedBy ? item.reportedBy.fullName : 'a campus neighbor' %></strong><span><%= item.reportedBy ? item.reportedBy.department : 'Campus community' %></span></div></div></div>
<div class="detail-content"><span class="eyebrow"><%= type === 'lost' ? 'Lost item report' : 'Found item report' %></span><h1><%= item.itemName %></h1><% if (type === 'found') { %><span class="status status-<%= item.status.toLowerCase() %>"><span></span><%= item.status === 'Available' ? 'Waiting for its owner' : 'Returned to its owner' %></span><% } else { %><span class="status status-missing"><span></span>Still looking</span><% } %><p class="detail-description"><%= item.description %></p><dl class="detail-facts"><div><dt><%= type === 'lost' ? 'Last seen' : 'Found at' %></dt><dd><%= type === 'lost' ? item.lastSeenLocation : item.foundLocation %></dd></div><div><dt>Date <%= type === 'lost' ? 'lost' : 'found' %></dt><dd><%= new Date(type === 'lost' ? item.dateLost : item.dateFound).toLocaleDateString('en', { weekday: 'short', month: 'long', day: 'numeric', year: 'numeric' }) %></dd></div></dl>
<% if (type === 'found' && item.status === 'Available' && currentStudent && item.reportedBy && String(item.reportedBy._id) !== String(currentStudent)) { %><form class="claim-panel" action="/found-items/<%= item._id %>/claims" method="post"><label for="reason">Think this might be yours?</label><p>Share a detail only the owner would know. The finder will review your claim.</p><textarea id="reason" name="reason" required minlength="12" maxlength="1000" rows="4" placeholder="I can identify this item because…"></textarea><button class="button button-primary" type="submit">Submit a claim <span aria-hidden="true">↗</span></button></form><% } else if (type === 'found' && item.status === 'Available' && !currentStudent) { %><div class="claim-prompt"><strong>Think this might be yours?</strong><p><a href="/students/new">Create a student profile</a> to submit a claim.</p></div><% } %>
<% if (type === 'found' && currentStudent && item.reportedBy && String(item.reportedBy._id) === String(currentStudent)) { %><section class="claims-panel"><div class="claims-heading"><div><span class="eyebrow">Finder tools</span><h2>Claims to review</h2></div><span class="claim-count"><%= claims.filter(claim => claim.status === 'Pending').length %> pending</span></div><% if (claims.length) { %><div class="claim-list"><% claims.forEach(claim => { %><article class="claim-card"><div class="claim-card-head"><strong><%= claim.claimedBy ? claim.claimedBy.fullName : 'A student' %></strong><span class="status status-<%= claim.status.toLowerCase() %>"><span></span><%= claim.status %></span></div><p><%= claim.reason %></p><% if (claim.status === 'Pending' && item.status === 'Available') { %><div class="claim-actions"><form action="/claims/<%= claim._id %>/status" method="post"><input type="hidden" name="status" value="Approved"><button class="button button-primary button-small" type="submit">Approve & return</button></form><form action="/claims/<%= claim._id %>/status" method="post"><input type="hidden" name="status" value="Rejected"><button class="button button-outline button-small" type="submit">Decline</button></form></div><% } %></article><% }) %></div><% } else { %><p class="no-claims">No claims yet. We’ll show them here when someone reaches out.</p><% } %></section><% } %>
</div></div></section>
<%- include('partials/footer') %>
