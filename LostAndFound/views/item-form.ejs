<%- include('partials/header', { title }) %>
<section class="form-page shell"><a class="back-link" href="/<%= type %>-items">← Back to <%= type %> items</a><div class="form-layout"><div class="form-intro"><span class="eyebrow"><%= type === 'lost' ? 'Let’s find it together' : 'A small kindness' %></span><h1><%= type === 'lost' ? 'Tell us what went missing.' : 'What did you find?' %></h1><p><%= type === 'lost' ? 'A few helpful details can bring your belonging back to you.' : 'Share a few details so its owner knows where to look.' %></p><div class="form-tip"><span>i</span><p>Your report is connected to your student profile. You can update your profile from the top right.</p></div></div>
<form class="surface-form" action="/<%= type %>-items" method="post"><% if (errors.length) { %><div class="form-errors" role="alert"><strong>Almost there</strong><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %><div class="field"><label for="itemName">What is it called?</label><input id="itemName" name="itemName" maxlength="100" required value="<%= form.itemName || '' %>" placeholder="e.g. Navy blue water bottle"><span class="field-help">A short name makes it easier to recognize.</span></div><div class="field-row"><div class="field"><label for="category">Category</label><select id="category" name="category" required><option value="">Choose a category</option><% ['Accessories','Bags','Books & stationery','Clothing','Electronics','ID & cards','Keys','Other'].forEach(category => { %><option <%= form.category === category ? 'selected' : '' %>><%= category %></option><% }) %></select></div><div class="field"><label for="date">Date <%= type === 'lost' ? 'lost' : 'found' %></label><input id="date" type="date" name="date" required value="<%= form.date || '' %>" max="<%= new Date().toISOString().slice(0,10) %>"></div></div><div class="field"><label for="location"><%= type === 'lost' ? 'Where did you last see it?' : 'Where did you find it?' %></label><input id="location" name="location" maxlength="160" required value="<%= form.location || '' %>" placeholder="e.g. Library, second floor"></div><div class="field"><label for="description">A few identifying details</label><textarea id="description" name="description" maxlength="1200" required rows="5" placeholder="Color, brand, distinguishing marks…"><%= form.description || '' %></textarea><span class="field-help">Please leave out sensitive personal information.</span></div><div class="form-actions"><button class="button button-primary" type="submit">Publish report <span aria-hidden="true">↗</span></button><a class="button button-quiet" href="/<%= type %>-items">Cancel</a></div></form></div></section>
<%- include('partials/footer') %>
