<%- include('partials/header', { title }) %>
<section class="shell profile-page"><a class="back-link" href="/">← Back home</a><div class="profile-card"><span class="avatar avatar-large"><%= student.fullName.split(' ').map(word => word[0]).slice(0,2).join('').toUpperCase() %></span><div><span class="eyebrow">Campus profile</span><h1><%= student.fullName %></h1><p><%= student.department %> · <%= student.email %> · <%= student.contactNumber %></p></div><a class="button button-outline" href="mailto:<%= student.email %>">Contact</a></div><div class="profile-stats"><div><strong><%= lostItems.length %></strong><span>lost reports</span></div><div><strong><%= foundItems.length %></strong><span>found reports</span></div></div><section class="profile-reports"><div class="section-heading"><div><span class="eyebrow">Your activity</span><h2>Lost item reports</h2></div><a class="button button-quiet" href="/lost-items/new">+ Report lost</a></div><% if (lostItems.length) { %><div class="report-row-list"><% lostItems.forEach(item => { %><a class="report-row" href="/lost-items/<%= item._id %>"><span class="report-icon">⌕</span><span class="report-row-main"><strong><%= item.itemName %></strong><small><%= item.lastSeenLocation %> · <%= new Date(item.dateLost).toLocaleDateString('en', { month: 'short', day: 'numeric' }) %></small></span><span class="status status-missing"><span></span>Still looking</span><span class="row-arrow">↗</span></a><% }) %></div><% } else { %><p class="profile-empty">No lost reports yet. <a href="/lost-items/new">Add one when you need to.</a></p><% } %></section><section class="profile-reports"><div class="section-heading"><div><span class="eyebrow">Helping out</span><h2>Found item reports</h2></div><a class="button button-quiet" href="/found-items/new">+ Report found</a></div><% if (foundItems.length) { %><div class="report-row-list"><% foundItems.forEach(item => { %><a class="report-row" href="/found-items/<%= item._id %>"><span class="report-icon report-icon-mint">✳</span><span class="report-row-main"><strong><%= item.itemName %></strong><small><%= item.foundLocation %> · <%= new Date(item.dateFound).toLocaleDateString('en', { month: 'short', day: 'numeric' }) %></small></span><span class="status status-<%= item.status.toLowerCase() %>"><span></span><%= item.status === 'Available' ? 'Waiting for owner' : 'Returned' %></span><span class="row-arrow">↗</span></a><% }) %></div><% } else { %><p class="profile-empty">No found reports yet. <a href="/found-items/new">Share the first one.</a></p><% } %></section></section>
<%- include('partials/footer') %>
